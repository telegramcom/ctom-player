<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_background"
    android:orientation="vertical" android:padding="14dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ctom~player  ·  LIQUID EQUALIZER" android:textColor="#75DCEC" android:textSize="11sp" android:letterSpacing="0.08" />
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Nothing playing" android:textColor="#F3F8FC" android:textSize="15sp" />
    <TextView android:id="@+id/widget_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Static mode ready" android:textColor="#90A9BA" android:textSize="11sp" />
    <TextView android:id="@+id/widget_bars" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:fontFamily="monospace" android:text="▂▅▃▇▆▃▅▇▂▆▃▇" android:textColor="#39D7ED" android:textSize="20sp" android:letterSpacing="0.08" />
    <TextView android:id="@+id/widget_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="00:00                         00:00" android:textColor="#90A9BA" android:textSize="11sp" />
</LinearLayout>