<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_background"
    android:orientation="vertical" android:padding="12dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="DEEP OCEAN VIDEO" android:textColor="#75DCEC" android:textSize="11sp" android:letterSpacing="0.12" />
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:text="Resume a video" android:textColor="#F3F8FC" android:textSize="16sp" android:maxLines="2" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/widget_remaining" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="No saved position" android:textColor="#90A9BA" android:textSize="11sp" />
        <ImageButton android:id="@+id/widget_play" android:layout_width="44dp" android:layout_height="36dp" android:background="@android:color/transparent" android:src="@android:drawable/ic_media_play" android:contentDescription="Resume video" android:tint="#75DCEC" />
    </LinearLayout>
</LinearLayout>