<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_background"
    android:gravity="center" android:orientation="vertical" android:padding="14dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ctom~player  ·  CONTROL CENTER" android:textColor="#75DCEC" android:textSize="11sp" android:letterSpacing="0.08" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:orientation="horizontal">
        <Button android:id="@+id/widget_music" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="MUSIC" android:textColor="#C8EAF1" android:textSize="11sp" />
        <Button android:id="@+id/widget_video" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="VIDEO" android:textColor="#C8EAF1" android:textSize="11sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:orientation="horizontal">
        <Button android:id="@+id/widget_favorites" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="FAVORITES" android:textColor="#C8EAF1" android:textSize="10sp" />
        <Button android:id="@+id/widget_playlists" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="PLAYLISTS" android:textColor="#C8EAF1" android:textSize="10sp" />
    </LinearLayout>
    <Button android:id="@+id/widget_search" android:layout_width="match_parent" android:layout_height="44dp" android:text="SEARCH" android:textColor="#75DCEC" android:textSize="11sp" />
</LinearLayout>