<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_background"
    android:gravity="center_vertical" android:orientation="horizontal" android:padding="10dp">
    <ImageView android:id="@+id/widget_art" android:layout_width="44dp" android:layout_height="44dp" android:background="#18364B" android:contentDescription="Album artwork" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
        <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nothing playing" android:textColor="#F3F8FC" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/widget_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ctom~player" android:textColor="#90A9BA" android:textSize="11sp" android:maxLines="1" />
    </LinearLayout>
    <ImageButton android:id="@+id/widget_play" android:layout_width="44dp" android:layout_height="44dp" android:background="@android:color/transparent" android:src="@android:drawable/ic_media_play" android:contentDescription="Play or pause" android:tint="#75DCEC" />
    <ImageButton android:id="@+id/widget_next" android:layout_width="44dp" android:layout_height="44dp" android:background="@android:color/transparent" android:src="@android:drawable/ic_media_next" android:contentDescription="Next" android:tint="#75DCEC" />
</LinearLayout>